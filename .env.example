# WattWise Environment Configuration
# Copy this file to .env and configure your local environment.

# Flask security
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Database engine: mysql or sqlite
DB_ENGINE=mysql

# MySQL connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=electricity_analysis

# Analytics configuration
DEFAULT_HIGH_USAGE_KWH=500
PORT=5000
